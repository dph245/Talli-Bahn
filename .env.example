HOST_PORT=8080
TRANSIT_PROVIDER=auto
DATABASE_PATH=data/gtfs.sqlite
# GTFS Germany: TripUpdates + ServiceAlerts, updated every 10 seconds.
# Set empty to disable realtime.
GTFS_RT_URL=https://realtime.gtfs.de/realtime-free.pb
GTFS_RT_TOKEN=
GTFS_RT_INTERVAL_SECONDS=60

# Supplementary platform data without an API key (60-second cache).
TRANSPORT_REST_ENABLED=true

# Optional supplementary rail provider. Keep credentials on the server.
DB_RIS_ENABLED=false
DB_CLIENT_ID=
DB_API_KEY=
DB_RIS_MAPPING_PATH=data/ris-mapping.json
